{
  "name": "native",
  "version": "1.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start -c",
    "start": "EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start -c",
    "android": "expo run:android",
    "android:dev": "bash scripts/run-android-dev.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:components": "vitest run components/"
  },
  "dependencies": {
    "@babel/runtime": "~7.29.7",
    "@clerk/expo": "^3.7.8",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/datetimepicker": "9.1.0",
    "@repo/api": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/emoji": "workspace:*",
    "@repo/theme": "workspace:*",
    "@tamagui/config": "^2.7.7",
    "@tanstack/react-query": "^5.103.1",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "expo": "^57.0.23",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-edge-to-edge": "^1.8.2",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.12.2",
    "tamagui": "^2.7.7"
  },
  "devDependencies": {
    "@tamagui/babel-plugin": "^2.7.7",
    "@tamagui/metro-plugin": "^2.7.7",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "@vitest/coverage-v8": "^5.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets",
        "react-native-reanimated",
        "typescript"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
